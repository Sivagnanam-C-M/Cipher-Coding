# Database
# Provide a MongoDB Atlas URI or local MongoDB connection URI:
# e.g., mongodb://localhost:27017/cipher_coding or mongodb+srv://<username>:<password>@cluster.mongodb.net/cipher_coding
MONGODB_URI=mongodb://localhost:27017/cipher_coding

# Authentication secret (used for signing HTTP-only session JWT cookies)
# Generate a strong 32+ character random string in production
AUTH_SECRET=super_secret_cipher_coding_zero_day_auth_token_key_32chars!

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment mode
NODE_ENV=development
